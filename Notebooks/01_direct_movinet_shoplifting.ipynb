{
 "cells": [
  {"cell_type":"markdown","metadata":{},"source":["# Direct fine-tuning — MoViNet-A0 shoplifting detector\n","\n","A fully runnable Google Colab pipeline: GPU check → dependency install → automatic download of a balanced UCF-Crime Shoplifting/Normal subset → robust video sampling → MoViNet-A0 fine-tuning → checkpointing → threshold selection → metrics/plots → saved inference bundle → GPU speed benchmark.\n","\n","Video decoding is CPU-side because Decord performs efficient random access; model training/inference is CUDA. The deployment model is only MoViNet-A0."]},
  {"cell_type":"code","execution_count":null,"metadata":{},"outputs":[],"source":["# 0. Colab setup\n","!nvidia-smi -L\n","!pip -q install -U \\\n","  \"transformers>=4.45\" \"accelerate>=0.34\" \"huggingface_hub>=0.25\" \\\n","  \"decord>=0.6.0\" \"einops>=0.8\" \"scikit-learn>=1.4\" \\\n","  \"pandas>=2.0\" \"matplotlib>=3.8\" \"seaborn>=0.13\" \"tqdm>=4.66\""]},
  {"cell_type":"code","execution_count":null,"metadata":{},"outputs":[],"source":["import os, json, random, time, math, warnings\n","from pathlib import Path\n","import numpy as np, pandas as pd\n","import matplotlib.pyplot as plt\n","import seaborn as sns\n","import torch\n","import torch.nn.functional as F\n","from torch.utils.data import Dataset, DataLoader\n","from sklearn.metrics import (accuracy_score, balanced_accuracy_score, precision_recall_fscore_support, roc_auc_score, average_precision_score, confusion_matrix, classification_report, roc_curve, precision_recall_curve)\n","from huggingface_hub import hf_hub_download\n","from tqdm.auto import tqdm\n","import decord\n","decord.bridge.set_bridge('native')\n","assert torch.cuda.is_available(), 'No CUDA GPU detected. In Colab choose Runtime → Change runtime type → GPU.'\n","DEVICE=torch.device('cuda')\n","torch.backends.cuda.matmul.allow_tf32=True\n","torch.backends.cudnn.benchmark=True\n","SEED=42\n","random.seed(SEED); np.random.seed(SEED); torch.manual_seed(SEED); torch.cuda.manual_seed_all(SEED)\n","ROOT=Path('/content/shoplifting_project'); DATA=ROOT/'data'; CKPT=ROOT/'checkpoints'; FIG=ROOT/'figures'\n","for p in (DATA,CKPT,FIG): p.mkdir(parents=True,exist_ok=True)\n","UCF_REPO='jinmang2/ucf_crime'\n","TRAIN_LIST='UCF_Crimes-Train-Test-Split/Action_Recognition_splits/train_001.txt'\n","VAL_LIST='UCF_Crimes-Train-Test-Split/Action_Recognition_splits/test_001.txt'\n","MODEL_ID='kfkas/movinet-a0-stream-pytorch'\n","LABELS=['normal','shoplifting']; LABEL2ID={'normal':0,'shoplifting':1}; ID2LABEL={0:'normal',1:'shoplifting'}\n","NUM_FRAMES=16; IMAGE_SIZE=172; EPOCHS=5; LR=2e-4; WEIGHT_DECAY=1e-4\n","VAL_CLIPS=3; RANDOM_TRAIN_CLIPS=True; HORIZONTAL_FLIP=True\n","MAX_TRAIN_VIDEOS=0; MAX_VAL_VIDEOS=0\n","VRAM_GB=torch.cuda.get_device_properties(0).total_memory/2**30\n","BATCH_SIZE=8 if VRAM_GB>=20 else 4 if VRAM_GB>=10 else 2\n","NUM_WORKERS=2\n","print('GPU:',torch.cuda.get_device_name(0),f'| VRAM: {VRAM_GB:.1f} GB | batch: {BATCH_SIZE}')"]},
  {"cell_type":"markdown","metadata":{},"source":["## 2. Download only the required videos\n","Download the split files, filter to Shoplifting and Normal, balance the classes, then download those videos. Hugging Face caching makes reruns incremental."]},
  {"cell_type":"code","execution_count":null,"metadata":{},"outputs":[],"source":["def read_split_file(path):\n","    local=hf_hub_download(repo_id=UCF_REPO,filename=path,repo_type='dataset')\n","    return [s.strip() for s in Path(local).read_text(errors='ignore').splitlines() if s.strip().lower().endswith('.mp4')]\n","def select_balanced(split_path,seed=SEED):\n","    items=read_split_file(split_path); pos=[(x,1) for x in items if x.startswith('Shoplifting/')]; neg=[(x,0) for x in items if 'Normal_Videos' in x]\n","    rng=random.Random(seed); rng.shuffle(pos); rng.shuffle(neg); n=min(len(pos),len(neg)); return pos[:n]+neg[:n]\n","train_items=select_balanced(TRAIN_LIST,SEED); val_items=select_balanced(VAL_LIST,SEED+1)\n","if MAX_TRAIN_VIDEOS: train_items=train_items[:MAX_TRAIN_VIDEOS]\n","if MAX_VAL_VIDEOS: val_items=val_items[:MAX_VAL_VIDEOS]\n","print('selected:',len(train_items),'train |',len(val_items),'val')\n","def download_items(items,split):\n","    rows=[]\n","    for rel,y in tqdm(items,desc=f'download {split}'):\n","        p=hf_hub_download(repo_id=UCF_REPO,filename=rel,repo_type='dataset',local_dir=str(DATA/split))\n","        rows.append({'path':str(p),'label':int(y),'rel':rel})\n","    return rows\n","train_files=download_items(train_items,'train'); val_files=download_items(val_items,'val')\n","pd.DataFrame(train_files+val_files).to_csv(ROOT/'manifest.csv',index=False)\n","print('download complete')"]},
  {"cell_type":"code","execution_count":null,"metadata":{},"outputs":[],"source":["def video_len(path):\n","    try: return len(decord.VideoReader(path,ctx=decord.cpu(0)))\n","    except Exception: return 0\n","def validate_files(rows):\n","    good=[]; bad=[]\n","    for r in tqdm(rows,desc='validate videos'):\n","        n=video_len(r['path'])\n","        (good if n>=2 else bad).append({**r,'frames':n})\n","    if bad: pd.DataFrame(bad).to_csv(ROOT/'bad_videos.csv',index=False)\n","    return good\n","train_files=validate_files(train_files); val_files=validate_files(val_files)\n","assert train_files and val_files, 'No usable videos remain.'\n","print('usable:',len(train_files),'train |',len(val_files),'val')"]},
  {"cell_type":"markdown","metadata":{},"source":["## 3. Temporal sampling\n","Training uses a random contiguous temporal window so a short shoplifting action is less likely to be diluted across a long video. Validation uses three evenly spaced clips and averages their logits."]},
  {"cell_type":"code","execution_count":null,"metadata":{},"outputs":[],"source":["def make_indices(total,n=NUM_FRAMES,start=None):\n","    if total<=n: return np.linspace(0,total-1,n).round().astype(np.int64)\n","    max_start=total-n; start=random.randint(0,max_start) if start is None else int(start)\n","    return np.linspace(start,start+n-1,n).round().astype(np.int64)\n","def decode_indices(path,idx):\n","    vr=decord.VideoReader(path,ctx=decord.cpu(0)); return vr.get_batch(np.asarray(idx,dtype=np.int64)).asnumpy()\n","def preprocess(frames,flip=False):\n","    x=torch.from_numpy(frames).permute(0,3,1,2).float().div_(255.0)\n","    x=F.interpolate(x,size=(IMAGE_SIZE,IMAGE_SIZE),mode='bilinear',align_corners=False)\n","    if flip and HORIZONTAL_FLIP and random.random()<0.5: x=torch.flip(x,[-1])\n","    return x\n","def validation_starts(total,k=VAL_CLIPS):\n","    if total<=NUM_FRAMES: return [0]\n","    return np.linspace(0,total-NUM_FRAMES,k).round().astype(int).tolist()\n","class ShopliftingVideoDataset(Dataset):\n","    def __init__(self,rows,train=False): self.rows=rows; self.train=train\n","    def __len__(self): return len(self.rows)\n","    def __getitem__(self,i):\n","        r=self.rows[i]\n","        if self.train:\n","            x=preprocess(decode_indices(r['path'],make_indices(r['frames'])),flip=True)\n","        else:\n","            x=torch.stack([preprocess(decode_indices(r['path'],s)) for s in validation_starts(r['frames'])])\n","        return x,torch.tensor(r['label'],dtype=torch.long),r['rel']\n","train_loader=DataLoader(ShopliftingVideoDataset(train_files,True),batch_size=BATCH_SIZE,shuffle=True,num_workers=NUM_WORKERS,pin_memory=True,persistent_workers=NUM_WORKERS>0)\n","val_loader=DataLoader(ShopliftingVideoDataset(val_files),batch_size=max(1,BATCH_SIZE//2),shuffle=False,num_workers=NUM_WORKERS,pin_memory=True,persistent_workers=NUM_WORKERS>0)\n","xb,yb,_=next(iter(train_loader)); vx,vy,_=next(iter(val_loader))\n","print('train batch:',tuple(xb.shape),'val batch:',tuple(vx.shape))"]},
  {"cell_type":"code","execution_count":null,"metadata":{},"outputs":[],"source":["# 4. Preview a real training clip\nr=random.choice(train_files); frames=decode_indices(r['path'],make_indices(r['frames']))\n","fig,axs=plt.subplots(2,8,figsize=(18,5))\n","for ax,fr in zip(axs.ravel(),frames): ax.imshow(fr); ax.axis('off')\n","fig.suptitle(f"Training sample — {LABELS[r['label']]} — {r['rel']}"); plt.tight_layout(); plt.show()"]},
  {"cell_type":"code","execution_count":null,"metadata":{},"outputs":[],"source":["# 5. Load MoViNet-A0\n","from transformers import AutoModelForVideoClassification\n","model=AutoModelForVideoClassification.from_pretrained(MODEL_ID,trust_remote_code=True,num_labels=2,ignore_mismatched_sizes=True,label2id=LABEL2ID,id2label=ID2LABEL).to(DEVICE)\n","print(f'parameters: {sum(p.numel() for p in model.parameters())/1e6:.2f}M')"]},
  {"cell_type":"code","execution_count":null,"metadata":{},"outputs":[],"source":["# 6. Evaluation and checkpoint utilities\n","def get_logits(out): return out.logits if hasattr(out,'logits') else out\n","def evaluate(model,loader):\n","    model.eval(); ys=[]; preds=[]; probs=[]\n","    with torch.inference_mode():\n","        for x,y,_ in tqdm(loader,desc='evaluate',leave=False):\n","            b,k,t,c,h,w=x.shape; flat=x.reshape(b*k,t,c,h,w).to(DEVICE,non_blocking=True)\n","            with torch.autocast('cuda',dtype=torch.float16): o=get_logits(model(pixel_values=flat))\n","            clip_logits=o.reshape(b,k,-1).float().mean(1); p=clip_logits.softmax(-1)[:,1]\n","            ys+=y.tolist(); preds+=clip_logits.argmax(-1).cpu().tolist(); probs+=p.cpu().tolist()\n","    p,r,f,_=precision_recall_fscore_support(ys,preds,average='binary',zero_division=0)\n","    m={'accuracy':accuracy_score(ys,preds),'balanced_accuracy':balanced_accuracy_score(ys,preds),'precision':p,'recall':r,'f1':f,\n","       'roc_auc':roc_auc_score(ys,probs) if len(set(ys))>1 else float('nan'),'average_precision':average_precision_score(ys,probs) if len(set(ys))>1 else float('nan'),\n","       'y':ys,'p':preds,'prob':probs}\n","    return m\n","def save_checkpoint(path,epoch,metrics):\n","    torch.save({'model_state_dict':model.state_dict(),'optimizer_state_dict':optimizer.state_dict(),'scheduler_state_dict':scheduler.state_dict(),\n","        'epoch':epoch,'metrics':{k:float(v) for k,v in metrics.items() if k not in ('y','p','prob')},'model_id':MODEL_ID,'num_frames':NUM_FRAMES,'image_size':IMAGE_SIZE,'labels':LABELS},path)"]},
  {"cell_type":"markdown","metadata":{},"source":["## 7. Fine-tune and save the best checkpoint"]},
  {"cell_type":"code","execution_count":null,"metadata":{},"outputs":[],"source":["scaler=torch.amp.GradScaler('cuda'); optimizer=torch.optim.AdamW(model.parameters(),lr=LR,weight_decay=WEIGHT_DECAY); scheduler=torch.optim.lr_scheduler.CosineAnnealingLR(optimizer,T_max=EPOCHS)\n","history=[]; best_f1=-1; best_path=CKPT/'movinet_direct_best.pt'\n","for epoch in range(1,EPOCHS+1):\n","    model.train(); running=0.0\n","    for x,y,_ in tqdm(train_loader,desc=f'epoch {epoch}/{EPOCHS}'):\n","        x=x.to(DEVICE,non_blocking=True); y=y.to(DEVICE,non_blocking=True); optimizer.zero_grad(set_to_none=True)\n","        with torch.autocast('cuda',dtype=torch.float16): loss=F.cross_entropy(get_logits(model(pixel_values=x)),y)\n","        scaler.scale(loss).backward(); scaler.unscale_(optimizer); torch.nn.utils.clip_grad_norm_(model.parameters(),1.0); scaler.step(optimizer); scaler.update(); running+=loss.item()\n","    scheduler.step(); val=evaluate(model,val_loader)\n","    row={'epoch':epoch,'train_loss':running/len(train_loader),'lr':optimizer.param_groups[0]['lr'],**{k:v for k,v in val.items() if k not in ('y','p','prob')}}; history.append(row); print(row)\n","    if val['f1']>best_f1: best_f1=val['f1']; save_checkpoint(best_path,epoch,val); print('saved',best_path)\n","pd.DataFrame(history).to_csv(ROOT/'direct_history.csv',index=False)\n","print('best F1:',best_f1)"]},
  {"cell_type":"code","execution_count":null,"metadata":{},"outputs":[],"source":["# 8. Reload best model and final metrics\n","bundle=torch.load(best_path,map_location=DEVICE); model.load_state_dict(bundle['model_state_dict']); final=evaluate(model,val_loader)\n","clean={k:float(v) for k,v in final.items() if k not in ('y','p','prob')}; print(json.dumps(clean,indent=2))\n","print(classification_report(final['y'],final['p'],target_names=LABELS,digits=4))\n","(ROOT/'final_metrics.json').write_text(json.dumps(clean,indent=2))"]},
  {"cell_type":"code","execution_count":null,"metadata":{},"outputs":[],"source":["# 9. Visualizations\n","h=pd.DataFrame(history); fig,ax=plt.subplots(1,2,figsize=(14,4)); ax[0].plot(h.epoch,h.train_loss,marker='o'); ax[0].set_title('Training loss'); ax[0].grid(alpha=.2)\n","ax[1].plot(h.epoch,h.f1,marker='o',label='F1'); ax[1].plot(h.epoch,h.balanced_accuracy,marker='o',label='Balanced accuracy'); ax[1].legend(); ax[1].set_title('Validation'); ax[1].grid(alpha=.2); plt.tight_layout(); plt.savefig(FIG/'training_curves.png',dpi=160); plt.show()\n","cm=confusion_matrix(final['y'],final['p']); plt.figure(figsize=(5,4)); sns.heatmap(cm,annot=True,fmt='d',xticklabels=LABELS,yticklabels=LABELS); plt.xlabel('Predicted'); plt.ylabel('True'); plt.title('Confusion matrix'); plt.tight_layout(); plt.savefig(FIG/'confusion_matrix.png',dpi=160); plt.show()\n","fpr,tpr,_=roc_curve(final['y'],final['prob']); prec,rec,_=precision_recall_curve(final['y'],final['prob']); fig,ax=plt.subplots(1,2,figsize=(12,4)); ax[0].plot(fpr,tpr); ax[0].plot([0,1],[0,1],'--'); ax[0].set_title(f"ROC AUC = {final['roc_auc']:.3f}"); ax[1].plot(rec,prec); ax[1].set_title(f"PR AP = {final['average_precision']:.3f}"); plt.tight_layout(); plt.savefig(FIG/'roc_pr.png',dpi=160); plt.show()"]},
  {"cell_type":"code","execution_count":null,"metadata":{},"outputs":[],"source":["# 10. Select a validation operating threshold and save a deployment bundle\n","thresholds=np.linspace(0.05,0.95,181); f1s=[]\n","for th in thresholds:\n","    pp=(np.asarray(final['prob'])>=th).astype(int); f1s.append(precision_recall_fscore_support(final['y'],pp,average='binary',zero_division=0)[2])\n","best_threshold=float(thresholds[int(np.argmax(f1s))]); print('validation F1-optimal threshold:',best_threshold)\n","plt.figure(figsize=(8,4)); plt.plot(thresholds,f1s); plt.axvline(best_threshold,ls='--'); plt.xlabel('Shoplifting probability threshold'); plt.ylabel('Validation F1'); plt.grid(alpha=.2); plt.show()\n","deployment=CKPT/'movinet_direct_deployment.pt'\n","torch.save({'model_state_dict':model.state_dict(),'model_id':MODEL_ID,'labels':LABELS,'label2id':LABEL2ID,'id2label':ID2LABEL,'num_frames':NUM_FRAMES,'image_size':IMAGE_SIZE,'threshold':best_threshold,'validation_metrics':clean},deployment)\n","print('saved:',deployment)"]},
  {"cell_type":"code","execution_count":null,"metadata":{},"outputs":[],"source":["# 11. GPU benchmark\n","model.eval(); x=next(iter(train_loader))[0].to(DEVICE,non_blocking=True)\n","for _ in range(5):\n","    with torch.inference_mode(),torch.autocast('cuda',dtype=torch.float16): _=get_logits(model(pixel_values=x))\n","torch.cuda.synchronize(); t0=time.perf_counter(); N=30\n","with torch.inference_mode():\n","    for _ in range(N):\n","        with torch.autocast('cuda',dtype=torch.float16): _=get_logits(model(pixel_values=x))\n","torch.cuda.synchronize(); elapsed=time.perf_counter()-t0\n","print(f'GPU batch latency: {elapsed/N*1000:.2f} ms | per clip: {elapsed/N/len(x)*1000:.2f} ms | throughput: {N*len(x)/elapsed:.2f} clips/s')"]},
  {"cell_type":"code","execution_count":null,"metadata":{},"outputs":[],"source":["# 12. Single-video inference\n","def predict_video(path,threshold=best_threshold):\n","    total=len(decord.VideoReader(str(path),ctx=decord.cpu(0))); starts=validation_starts(total); clips=[preprocess(decode_indices(str(path),s)) for s in starts]\n","    x=torch.stack(clips).to(DEVICE)\n","    with torch.inference_mode(),torch.autocast('cuda',dtype=torch.float16): logits_=get_logits(model(pixel_values=x)).float().mean(0)\n","    prob=float(logits_.softmax(-1)[1].cpu()); return {'label':'shoplifting' if prob>=threshold else 'normal','shoplifting_probability':prob,'threshold':threshold,'clips':len(clips)}\n","print(predict_video(train_files[0]['path']))"]},
  {"cell_type":"markdown","metadata":{},"source":["## Outputs\n","The notebook creates: movinet_direct_best.pt, movinet_direct_deployment.pt, manifest.csv, direct_history.csv, final_metrics.json, and plots under figures/.\n","\n","For a smoke test before Run all, set MAX_TRAIN_VIDEOS=40, MAX_VAL_VIDEOS=20, EPOCHS=1. Restore them afterward."]} 
